# Base URL of your taxifare FastAPI (no trailing slash)
# Local:  http://127.0.0.1:8000
# Cloud:  https://YOUR-SERVICE-xxxxx.run.app
TAXIFARE_API_URL=http://127.0.0.1:8000

# Optional. Enable Places API in Google Cloud and restrict the key.
# Without it, address autocomplete falls back to Photon (OpenStreetMap).
GOOGLE_PLACES_API_KEY=
